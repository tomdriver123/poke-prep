    "@angular/router": "20.3.18",
    "@ionic/angular": "8.8.3",
    "@types/leaflet": "1.9.22",
    "ionicons": "7.4.0",
    "js-yaml": "4.1.1",
    "leaflet": "1.9.4",
    "marked": "16.4.2",
    "ngx-markdown": "20.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.23",
